{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "proto-blocks/site-footer",
  "title": "Site Footer",
  "description": "E2E fixture: site footer band with a copyright line and a navigation slot.",
  "category": "proto-blocks",
  "supports": { "html": false, "anchor": true },
  "protoBlocks": {
    "version": "1.0",
    "template": "template.php",
    "useTailwind": false,
    "fields": {
      "copyright": { "type": "text", "tagName": "p", "format": "plain" },
      "navigation": {
        "type": "inner-blocks",
        "allowedBlocks": ["core/navigation"],
        "template": [["core/navigation", { "overlayMenu": "never" }]],
        "templateLock": false,
        "orientation": "horizontal"
      }
    }
  }
}
